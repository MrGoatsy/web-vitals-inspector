{
    "manifest_version": 2,
    "name": "Web Vitals Inspector",
    "version": "1.2.0",
    "author": "HeekDevelopment",
    "homepage_url": "https://heekdevelopment.com/",
    "description": "Measures LCP, INP, CLS, FCP and TTFB on the sites you enable and lists the elements behind them in a DevTools panel. Click an element to outline it on the page.",
    "icons": {
        "48": "icon.svg",
        "96": "icon.svg"
    },
    "permissions": ["storage"],
    "browser_specific_settings": {
        "gecko": {
            "id": "layout-shift-inspector@heekdevelopment.com",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "background": {
        "scripts": ["background.js"]
    },
    "devtools_page": "devtools.html",
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_start"
        }
    ]
}
